{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeveloperS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::company-project-storage"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::company-project-storage/*"
    }
  ]
}
